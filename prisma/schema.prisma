// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// change the casing in production
enum UserRole {
  admin
  teacher
  student
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model temp_users {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  first_name          String
  last_name           String
  role                UserRole     @default(student)
  date_of_birth       DateTime?
  gender              Gender @default(OTHER)
  phone               String?
  house_number        String?
  street              String?
  city                String?
  pincode             String?
  verification_token  String?
  expires_at          DateTime  @default(dbgenerated("NOW() + INTERVAL '24 hours'"))
  created_at          DateTime  @default(now())
  is_verified         Boolean   @default(false)
  temp_teachers       temp_teachers[]
}

model temp_teachers {
  id                              Int       @id @default(autoincrement())
  temp_user_id                    Int
  qualification                   String?
  experience_years                Int?
  subjects_taught                 String[]
  teaching_mode                   String?
  pan_number                      String?
  aadhar_url                      String?
  aadhar_url_public_id            String?
  resume_url                      String?
  resume_url_public_id            String?
  certificates_url                String[]
  certificates_url_public_ids     String[]
  tenth_percentage                Float?
  twelfth_percentage              Float?
  marksheet_url_tenth             String?
  marksheet_url_tenth_public_id   String?
  marksheet_url_twelfth           String?
  marksheet_url_twelfth_public_id String?
  availability_schedule           Json?
  created_at                      DateTime  @default(now())
  updated_at                      DateTime  @default(now())
  temp_user                       temp_users @relation(fields: [temp_user_id], references: [id], onDelete: Cascade)
}

model users {
  id                        Int       @id @default(autoincrement())
  email                     String    @unique
  password_hash             String?
  role                      String
  first_name                String
  last_name                 String
  gender                    Gender         @default(OTHER)
  phone                     String?
  house_number              String?
  street                    String?
  city                      String?
  pincode                   String?
  date_of_birth             DateTime?
  location                  String?
  home_latitude             Float?
  home_longitude            Float?
  is_verified               Boolean   @default(false)
  verification_token        String?
  verification_token_expires DateTime?
  reset_token               String?
  reset_token_expires       DateTime?
  access_token              String?
  profile_image_url         String? // remove this later
  profile_image_url_public_id String?  // remove this later

  is_active                 Boolean   @default(true)
  is_deleted                Boolean   @default(false)
  created_at                DateTime  @default(now())
  updated_at                DateTime  @default(now())
  deleted_at                DateTime?

  students                  students[]
  teachers                  teachers[]
  teacher_student_assignments teacher_student_assignments[] // As assigned_by
  attendance                attendance[] // As marked_by
  
  payments                  Payments[] // As processed_by
  // salary_payments           SalaryPayment[] // As processed_by

  system_settings           system_settings[] // As updated_by
  audit_logs                audit_logs[] // As user_id
  teachers_approved_by      teachers[] @relation("teachers_approved_by")
}

model students {
  id                    Int       @id @default(autoincrement())
  user_id               Int
  assigned_teacher_id   Int?
  grade                 String?
  school_name           String?
  parent_name           String?
  parent_phone          String?
  parent_email          String?
  emergency_contact     String?
  subjects_interested   String[]
  preferred_schedule    String?

// fee details
  fee_assigned           Boolean   @default(false)
  monthly_fee           Float     @default(0)
  fee_due_date          DateTime?
  grace_period_end      DateTime?
  last_fee_payment_date DateTime?
  
  aadhar_url            String?
  aadhar_url_public_id  String?
  enrollment_date       DateTime  @default(dbgenerated("CURRENT_DATE"))
  is_active             Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now())

  user                  users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  assigned_teacher      teachers? @relation("student_assigned_teacher", fields: [assigned_teacher_id], references: [id])
  // student_fees          student_fees[]
  teacher_student_assignments teacher_student_assignments[]
  assignments           assignments[]
  assignment_submissions assignment_submissions[]
  attendance            attendance[]

  fee_payments          FeePayment[]
  // payments              payments[]
}



model teachers {
  id                              Int       @id @default(autoincrement())
  user_id                         Int
  qualification                   String?
  experience_years                Int?
  subjects_taught                 String[]
  teaching_mode                   String?

  salary_assigned                 Boolean   @default(false)
  monthly_salary                  Float     @default(0)
  salary_pay_day                  Int       @default(1)
  last_salary_payment_date        DateTime? 
  
  bank_account_number             String?
  bank_ifsc_code                  String?
  bank_name                       String?
  account_holder_name             String?
  aadhar_url                      String?
  aadhar_url_public_id            String?
  resume_url                      String?
  resume_url_public_id            String?
  certificates_url                String[]
  certificates_url_public_id      String?
  tenth_percentage                Float?
  twelfth_percentage              Float?
  marksheet_url_tenth             String?
  marksheet_url_tenth_public_id   String?
  marksheet_url_twelfth           String?
  marksheet_url_twelfth_public_id String?
  approval_status                 String    @default("pending")   // remove this latter
  approved_by                     Int?  // remove this line
  approved_at                     DateTime?
  // rejection_reason                String?
  availability_schedule           Json?
  max_students                    Int       @default(20)
  current_students                Int       @default(0)
  rating                          Float     @default(0)
  total_reviews                   Int       @default(0)
  is_active                       Boolean   @default(true)
  created_at                      DateTime  @default(now())
  updated_at                      DateTime  @default(now())

  user                            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  approved_by_user                users?    @relation("teachers_approved_by", fields: [approved_by], references: [id])
  assigned_students               students[] @relation("student_assigned_teacher")
  teacher_student_assignments     teacher_student_assignments[]
  assignments                     assignments[]
  assignment_submissions          assignment_submissions[] // As graded_by
  attendance                      attendance[]
  salary_payments                 SalaryPayment[]
}


// pairing
model teacher_student_assignments {
  id          Int       @id @default(autoincrement())
  teacher_id  Int
  student_id  Int
  assigned_date DateTime @default(dbgenerated("CURRENT_DATE"))
  assigned_by Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())

  teacher     teachers  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  student     students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  assigned_by_user users? @relation(fields: [assigned_by], references: [id])

  @@unique([teacher_id, student_id])
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
  GRADED
}


model assignments {
  id              Int       @id @default(autoincrement())
  teacher_id      Int
  student_id      Int
  title           String
  description     String?
  subject         String?
  due_date        DateTime?
  assignment_type String?
  max_marks       Int       @default(100)
  instructions    String?
  grade           String?
  status          AssignmentStatus @default(ASSIGNED)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())

  teacher         teachers  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  student         students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  assignment_attachments assignment_attachments[]
  assignment_submissions assignment_submissions[]
}

model assignment_attachments {
  id                Int       @id @default(autoincrement())
  assignment_id     Int
  file_name         String?
  file_url          String?
  file_url_publicId String?
  mime_type         String?
  size              Int?
  is_submission     Boolean   @default(false)
  created_at        DateTime  @default(now())

  assignment        assignments @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
}

model assignment_submissions {
  id             Int       @id @default(autoincrement())
  assignment_id  Int
  student_id     Int
  
  submission_text String?
  submitted_at   DateTime  @default(now())
  marks_obtained Int?
  grade          String?
  feedback       String?


// only appliend when recreating the databse from scratch
  file_url       String?
  file_name      String?
  file_url_publicId String?
  mime_type      String?

  // graded_at      DateTime 
  graded_by      Int?
  is_late        Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())

  assignment     assignments @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student        students    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  graded_by_teacher teachers? @relation(fields: [graded_by], references: [id])

  @@unique([assignment_id, student_id])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model attendance {
  id              Int       @id @default(autoincrement())
  student_id      Int
  teacher_id      Int
  date            DateTime
  status          AttendanceStatus 
  notes           String?
  marked_by       Int
  marked_at       DateTime  @default(now())
  session_duration Int?
  subject         String?
  latitude        Float?
  longitude       Float?
  created_at      DateTime  @default(now())

  student         students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teacher         teachers  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  marked_by_user  users?    @relation(fields: [marked_by], references: [id])

  @@unique([student_id, teacher_id, date, subject])
}


enum PaymentType {
  SALARY
  FEE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ONLINE_PAYMENT
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

model Payments {
  id              Int             @id @default(autoincrement())

  amount          Float
  payment_type    PaymentType
  payment_method  PaymentMethod
  transactionId   String          @unique
  payment_date    DateTime        @default(now())
  status PaymentStatus            @default(SUCCESS)
  notes           String?         // for remarks like “via Razorpay”, “manual correction”, etc.

  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now())

  processedById   Int?
  processedBy     users?           @relation(fields: [processedById], references: [id])

  salaryPaymentId Int?            @unique
  salaryPayment   SalaryPayment?  @relation(fields: [salaryPaymentId], references: [id], onDelete: Cascade)
  
  feePaymentId    Int?            @unique
  feePayment      FeePayment?     @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)


  @@index([payment_type, payment_date])
  @@index([processedById])
}

enum SalaryStatus {
  PAID
  UNPAID
}

model SalaryPayment {
  id              Int       @id @default(autoincrement())
  date           DateTime
  
  // base_salary     Float
  // bonus           Float     @default(0)
  // deductions      Float     @default(0)
  total_amount    Float
  status          SalaryStatus    @default(UNPAID) // or paid, processing, etc.

  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())

  teacherId       Int
  teacher         teachers   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // processedById   Int?
  // processedBy     users?     @relation(fields: [processedById], references: [id])

  payment         Payments?

  @@unique([teacherId, date])
  @@index(date)
}

enum FeeStatus {
  DUE
  PAID
  OVERDUE
}

model FeePayment {
  id             Int       @id @default(autoincrement())
  paidAt           DateTime?  // as not paid fees can have null paidAt

  total_amount         Float
  due_date       DateTime?

  status         FeeStatus    @default(DUE) 
  reminder_sent  Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())

  studentId      Int
  student        students   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  payment        Payments?

  @@unique([studentId, paidAt])
  @@index(paidAt)
}


model system_settings {
  id           Int       @id @default(autoincrement())
  setting_key  String    @unique
  setting_value String?
  setting_type String?
  description  String?
  is_public    Boolean   @default(false)
  updated_by   Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now())

  updated_by_user users? @relation(fields: [updated_by], references: [id])
}

model audit_logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String
  table_name String?
  record_id  Int?
  old_values Json?
  new_values Json?
  ip_address String?
  user_agent String?
  created_at DateTime  @default(now())

  user       users?    @relation(fields: [user_id], references: [id])
}

